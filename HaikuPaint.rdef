resource app_signature "application/x-vnd.HaikuPaint";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 2,
	middle = 0,
	minor  = 0,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "HaikuPaint",
	long_info = "A MacPaint-style 1-bit paint program for Haiku."
};

resource file_types message {
	"types" = "image/x-macpaint"
};
